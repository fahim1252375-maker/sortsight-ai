# SortSight AI environment configuration
# Copy this file to .env for local development.
# Generate strong values with: openssl rand -hex 32

# Gemini API key (optional; the app uses its deterministic local fallback when empty).
GEMINI_API_KEY=

# Public origin of this deployment. Use the exact https origin in production.
APP_URL=http://localhost:3000

# Required in production. JWT_SECRET must be at least 32 characters.
JWT_SECRET=

# Required in production. Must be exactly 64 hexadecimal characters (32 bytes).
ENCRYPTION_KEY=

# SQLite database file. The application creates it and applies migrations automatically.
DATABASE_PATH=./data/sortsight.db

# Local server settings.
PORT=3000
NODE_ENV=development

# Demo fixtures are enabled automatically outside production.
# Set SEED_DEMO_DATA=true only when you explicitly want demo users/data in production.
SEED_DEMO_DATA=false

# Optional SMTP integration. Leave empty to disable outbound email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hardware integrations remain simulator-only unless a real gateway is configured.
PLC_GATEWAY_MODE=simulator
